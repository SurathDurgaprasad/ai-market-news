# REQUIRED for ingestion
# The API still serves stored events when this is missing. It does not
# switch to a test provider. Ingestion stops and /api/health reports degraded.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=

# OPTIONAL — model and endpoint overrides
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OPTIONAL — used only when LLM_PROVIDER is openai, anthropic, or bedrock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BEDROCK_MODEL_ID=

# DATABASE — SQLite file, created on startup if missing
# Path is relative to the directory you start uvicorn from (backend/).
DATABASE_URL=sqlite:///./ai_platform.db

# CORS — comma-separated browser origins. No wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DEVELOPMENT ONLY
# TESTING=1 makes the process use the deterministic test provider.
# Do not set TESTING or TEST_MODE in production.
# TEST_MODE=1 also forces a separate sqlite file named test.db.
